# ==============================================================================
# VARIABILE DE MEDIU - MASA ROTUNDĂ TIMIȘOARA (EXEMPLU)
# ==============================================================================
# Copiază acest fișier ca `.env` pe calculatorul tău local.
# NU urca niciodată fișierul `.env` pe GitHub! El este deja adăugat în .gitignore.
# ==============================================================================

# Web3Forms Access Key pentru trimiterea formularelor (obținut de pe https://web3forms.com)
PUBLIC_WEB3FORMS_KEY=your_web3forms_access_key_here

# Token Cloudflare Web Analytics (opțional, cookieless)
PUBLIC_CLOUDFLARE_ANALYTICS_TOKEN=your_cloudflare_analytics_token_here

# URL-ul site-ului
PUBLIC_SITE_URL=https://mrt.ro
