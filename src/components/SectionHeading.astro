---
interface Props {
  title: string;
  subtitle?: string;
  centered?: boolean;
  class?: string;
}

const {
  title,
  subtitle,
  centered = true,
  class: className = '',
} = Astro.props;
---

<div class:list={['section-heading', { 'is-centered': centered }, className]}>
  <h2 class="heading-title">{title}</h2>
  {subtitle && <p class="heading-subtitle">{subtitle}</p>}
</div>

<style>
  .section-heading {
    margin-bottom: var(--space-2xl);
  }

  .section-heading.is-centered {
    text-align: center;
  }

  .heading-title {
    color: var(--color-primary);
    font-size: clamp(1.8rem, 2.5vw + 0.5rem, 2.5rem);
    font-weight: var(--font-weight-bold);
    line-height: var(--line-height-heading);
    letter-spacing: -0.015em;
    margin-bottom: 0;
    position: relative;
    display: inline-block;
  }

  .section-heading.is-centered .heading-title {
    display: table;
    margin-inline: auto;
  }

  .heading-title::after {
    content: '';
    display: block;
    width: 64px;
    height: 4px;
    background-color: var(--color-accent);
    border-radius: var(--radius-xs, 2px);
    margin-top: var(--space-sm);
  }

  .section-heading.is-centered .heading-title::after {
    margin-inline: auto;
  }

  .heading-subtitle {
    margin-top: var(--space-md);
    margin-bottom: 0;
    font-size: var(--font-size-md);
    line-height: var(--line-height-base);
    color: var(--color-text-light);
    max-width: 700px;
  }

  .section-heading.is-centered .heading-subtitle {
    margin-inline: auto;
  }
</style>
