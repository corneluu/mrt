---
import { getRelativePath } from '@/utils/paths';

interface Partener {
  nume: string;
  logo: string;
  website?: string;
  tip?: string;
  descriere?: string;
}

interface Props {
  parteneri: Partener[];
}

const { parteneri } = Astro.props;
---

<div class="partner-grid">
  {parteneri.map(partener => {
    const CardContent = (
      <div class="partner-card">
        <div class="partner-logo-box">
          <img
            src={getRelativePath(partener.logo)}
            alt={`Logo ${partener.nume}`}
            loading="lazy"
            width="160"
            height="80"
          />
        </div>
        <span class="partner-name">{partener.nume}</span>
      </div>
    );

    return partener.website ? (
      <a
        href={partener.website}
        target="_blank"
        rel="noopener noreferrer"
        class="partner-link"
        aria-label={`Vizitează site-ul partenerului ${partener.nume}`}
      >
        {CardContent}
      </a>
    ) : (
      <div class="partner-wrapper">
        {CardContent}
      </div>
    );
  })}
</div>

<style>
  .partner-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(140px, 1fr));
    gap: var(--space-md);
    align-items: stretch;
  }

  .partner-link,
  .partner-wrapper {
    display: block;
    text-decoration: none;
    color: inherit;
  }

  .partner-card {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding: var(--space-lg);
    background: var(--color-white);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    height: 100%;
    min-height: 140px;
    box-shadow: var(--shadow-sm);
    transition: transform var(--transition), box-shadow var(--transition), border-color var(--transition);
  }

  .partner-link:hover .partner-card {
    transform: translateY(-4px);
    box-shadow: var(--shadow-md);
    border-color: var(--color-primary-light);
  }

  .partner-logo-box {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    height: 70px;
    margin-bottom: var(--space-sm);
  }

  .partner-logo-box img {
    max-width: 140px;
    max-height: 60px;
    object-fit: contain;
    filter: grayscale(100%);
    opacity: 0.8;
    transition: filter var(--transition), opacity var(--transition);
  }

  .partner-link:hover .partner-logo-box img,
  .partner-card:hover .partner-logo-box img {
    filter: grayscale(0%);
    opacity: 1;
  }

  .partner-name {
    font-size: 0.9rem;
    font-weight: 600;
    color: var(--color-text);
    text-align: center;
  }
</style>
