---
interface Props {
  titlu: string;
  descriere?: string;
  rezumat?: string;
  imagine: string;
  data?: Date | string;
  dataPublicare?: Date | string;
  categorie: string;
  slug: string;
}

const {
  titlu,
  descriere,
  rezumat,
  imagine,
  data,
  dataPublicare,
  categorie,
  slug,
} = Astro.props;

const descriereFinal = descriere || rezumat || '';
const rawData = data || dataPublicare || new Date();
const dateObj = rawData instanceof Date ? rawData : new Date(rawData);

const formattedDate = new Intl.DateTimeFormat('ro-RO', {
  day: 'numeric',
  month: 'long',
  year: 'numeric',
}).format(dateObj);

const cleanSlug = slug.replace(/\.(md|mdx|json)$/, '');
const articleUrl = `/noutati/${cleanSlug}/`;

const categorieMap: Record<string, string> = {
  eveniment: 'Eveniment',
  stire: 'Știre',
  raport: 'Raport',
  comunitate: 'Comunitate',
};

const categoryLabel = categorieMap[categorie] ?? (categorie.charAt(0).toUpperCase() + categorie.slice(1));
---

<article class="card news-card">
  <div class="card-image-wrap">
    <a href={articleUrl} tabindex="-1" aria-hidden="true">
      <img
        src={imagine}
        alt={titlu}
        loading="lazy"
        decoding="async"
        class="card-img"
      />
    </a>
  </div>

  <div class="card-body">
    <div class="card-meta">
      <span class:list={['badge', `badge-${categorie}`]}>{categoryLabel}</span>
      <time datetime={dateObj.toISOString()} class="news-date">
        <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <rect width="18" height="18" x="3" y="4" rx="2" ry="2"></rect>
          <line x1="16" x2="16" y1="2" y2="6"></line>
          <line x1="8" x2="8" y1="2" y2="6"></line>
          <line x1="3" x2="21" y1="10" y2="10"></line>
        </svg>
        <span>{formattedDate}</span>
      </time>
    </div>

    <h3 class="card-title">
      <a href={articleUrl}>{titlu}</a>
    </h3>

    <p class="card-desc">{descriereFinal}</p>

    <div class="card-footer-action">
      <a href={articleUrl} class="read-more-link" aria-label={`Citește articolul: ${titlu}`}>
        Citește articolul <span class="arrow" aria-hidden="true">&rarr;</span>
      </a>
    </div>
  </div>
</article>

<style>
  .news-card {
    display: flex;
    flex-direction: column;
    height: 100%;
    transition: transform var(--transition-normal), box-shadow var(--transition-normal), border-color var(--transition-normal);
  }

  .card-image-wrap {
    position: relative;
    width: 100%;
    aspect-ratio: 16 / 9;
    overflow: hidden;
    background-color: var(--color-bg-alt);
  }

  .card-img {
    width: 100%;
    height: 100%;
    aspect-ratio: 16 / 9;
    object-fit: cover;
    transition: transform var(--transition-normal);
    display: block;
  }

  .news-card:hover .card-img {
    transform: scale(1.05);
  }

  .card-body {
    display: flex;
    flex-direction: column;
    flex-grow: 1;
    padding: var(--space-lg);
  }

  .card-meta {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-sm);
    margin-bottom: var(--space-sm);
    flex-wrap: wrap;
  }

  .news-date {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    font-size: var(--font-size-xs);
    color: var(--color-text-muted);
  }

  .news-date svg {
    color: var(--color-text-muted);
    flex-shrink: 0;
  }

  /* Category Badges */
  .badge-eveniment {
    background-color: rgba(212, 168, 67, 0.2);
    color: #8A6517;
  }

  .badge-stire {
    background-color: rgba(27, 58, 92, 0.12);
    color: var(--color-primary);
  }

  .badge-raport {
    background-color: rgba(72, 187, 120, 0.18);
    color: #22543D;
  }

  .badge-comunitate {
    background-color: #E9D8FD;
    color: #553C9A;
  }

  .card-title {
    font-size: var(--font-size-lg);
    line-height: var(--line-height-tight);
    margin-top: 0;
    margin-bottom: var(--space-xs);
  }

  .card-title a {
    color: var(--color-primary);
    text-decoration: none;
    transition: color var(--transition);
  }

  .card-title a:hover {
    color: var(--color-secondary);
  }

  .card-desc {
    color: var(--color-text-light);
    font-size: var(--font-size-sm);
    line-height: 1.6;
    margin-bottom: var(--space-md);
    flex-grow: 1;
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .card-footer-action {
    margin-top: auto;
    padding-top: var(--space-sm);
    border-top: 1px solid var(--color-border);
  }

  .read-more-link {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    color: var(--color-primary);
    font-size: var(--font-size-sm);
    font-weight: var(--font-weight-semibold);
    text-decoration: none;
    transition: color var(--transition-fast), gap var(--transition-fast);
  }

  .read-more-link .arrow {
    transition: transform var(--transition-fast);
  }

  .read-more-link:hover {
    color: var(--color-secondary);
  }

  .read-more-link:hover .arrow {
    transform: translateX(4px);
  }
</style>
