---
import { getSetari } from '@/utils/supabase';
import { getRelativePath } from '@/utils/paths';
import SocialLinks from '@/components/SocialLinks.astro';

const currentYear = new Date().getFullYear();

const footerLinks = [
  {
    title: 'Organizația',
    links: [
      { label: 'Despre noi', href: getRelativePath('/despre/') },
      { label: 'Proiecte', href: getRelativePath('/proiecte/') },
      { label: 'Noutăți', href: getRelativePath('/noutati/') },
      { label: 'Galerie', href: getRelativePath('/galerie/') },
    ],
  },
  {
    title: 'Implică-te',
    links: [
      { label: 'Donează', href: getRelativePath('/donatii/') },
      { label: 'Fii voluntar', href: getRelativePath('/voluntariat/') },
      { label: 'Parteneri', href: getRelativePath('/parteneri/') },
      { label: 'Contact', href: getRelativePath('/contact/') },
    ],
  },
  {
    title: 'Legal',
    links: [
      { label: 'Confidențialitate', href: getRelativePath('/confidentialitate/') },
      { label: 'Termeni și condiții', href: getRelativePath('/termeni/') },
      { label: 'Date juridice', href: getRelativePath('/date-juridice/') },
    ],
  },
];
const { contact: c, juridic: j } = await getSetari();
---

<footer class="site-footer">
  <div class="container">
    <div class="footer-grid">
      <!-- Brand -->
      <div class="footer-brand">
        <a href={getRelativePath('/')} class="footer-logo" aria-label="Masa Rotundă Timișoara">
          <img src={getRelativePath('/images/logo-mrt.png')} alt="Masa Rotundă Timișoara Logo" width="56" height="56" />
          <span>
            <strong>Masa Rotundă</strong>
            <small>Timișoara</small>
          </span>
        </a>
        <p class="footer-tagline">
          MRT este o Asociație nonprofit care are ca scop îmbunătățirea relațiilor și creșterea calității vieții în comunitatea locală și nu numai.
        </p>
        <!-- Social links -->
        <SocialLinks />
      </div>

      <!-- Link columns -->
      {footerLinks.map(group => (
        <div class="footer-col">
          <h3 class="footer-heading">{group.title}</h3>
          <ul role="list">
            {group.links.map(link => (
              <li><a href={link.href}>{link.label}</a></li>
            ))}
          </ul>
        </div>
      ))}
    </div>

    <!-- Legal bar -->
    <div class="footer-legal">
      <div class="footer-legal-info">
        <p>
          <strong>{j.denumire}</strong>
          {j.cui && <> · CUI: {j.cui}</>}
          {j.iban && <> · IBAN: {j.iban}</>}
          {j.banca && <> · Banca: {j.banca}</>}
        </p>
        <p>{c.adresa}</p>
      </div>
      <p class="footer-copyright">
        &copy; {currentYear} Masa Rotundă Timișoara. Toate drepturile rezervate.
      </p>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    background: var(--color-primary-dark);
    color: var(--color-text-on-dark);
    padding: var(--space-2xl) 0 var(--space-lg);
    margin-top: var(--space-3xl);
  }

  .footer-grid {
    display: grid;
    grid-template-columns: 2fr 1fr 1fr 1fr;
    gap: var(--space-xl);
    padding-bottom: var(--space-xl);
    border-bottom: 1px solid rgba(255, 255, 255, 0.15);
  }

  .footer-logo {
    display: flex;
    align-items: center;
    gap: var(--space-xs);
    color: var(--color-white);
    text-decoration: none;
    margin-bottom: var(--space-md);
  }

  .footer-logo img {
    width: 48px;
    height: 48px;
    object-fit: contain;
    border-radius: 50%;
    background-color: var(--color-white);
    padding: 3px;
  }

  .footer-logo span {
    display: flex;
    flex-direction: column;
    line-height: 1.2;
  }

  .footer-logo strong {
    font-size: 1.1rem;
  }

  .footer-logo small {
    font-size: 0.85rem;
    opacity: 0.8;
  }

  .footer-tagline {
    font-size: 0.9rem;
    opacity: 0.85;
    line-height: 1.6;
    margin-bottom: var(--space-md);
    max-width: 320px;
  }

  .footer-heading {
    font-size: 1rem;
    font-weight: 600;
    margin-bottom: var(--space-md);
    color: var(--color-accent);
  }

  .footer-col ul {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .footer-col li {
    margin-bottom: var(--space-xs);
  }

  .footer-col a {
    color: rgba(255, 255, 255, 0.8);
    text-decoration: none;
    font-size: 0.9rem;
    transition: color var(--transition);
  }

  .footer-col a:hover,
  .footer-col a:focus-visible {
    color: var(--color-white);
  }

  .footer-legal {
    padding-top: var(--space-lg);
    text-align: center;
    font-size: 0.8rem;
    opacity: 0.7;
  }

  .footer-legal-info {
    margin-bottom: var(--space-sm);
  }

  .footer-legal-info p {
    margin: 0 0 var(--space-xs);
  }

  .footer-copyright {
    margin: 0;
  }

  @media (max-width: 767px) {
    .footer-grid {
      grid-template-columns: 1fr;
      gap: var(--space-lg);
    }
  }

  @media (min-width: 768px) and (max-width: 1023px) {
    .footer-grid {
      grid-template-columns: 1fr 1fr;
    }
  }
</style>
