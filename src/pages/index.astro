---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { getRelativePath } from '@/utils/paths';
import Hero from '@/components/Hero.astro';
import SectionHeading from '@/components/SectionHeading.astro';
import ImpactNumbers from '@/components/ImpactNumbers.astro';
import ProjectCard from '@/components/ProjectCard.astro';
import PartnerGrid from '@/components/PartnerGrid.astro';
import { getCollection } from 'astro:content';

const proiecte = (await getCollection('proiecte'))
  .filter(p => p.data.status === 'activ')
  .sort((a, b) => b.data.dataStart.getTime() - a.data.dataStart.getTime())
  .slice(0, 3);

const parteneri = (await getCollection('parteneri'))
  .sort((a, b) => a.data.ordine - b.data.ordine);
---

<BaseLayout
  title="Acasă"
  description="Masa Rotundă Timișoara este un ONG caritabil dedicat meselor calde, educației copiilor defavorizați și caravanelor medicale în Timișoara și județul Timiș."
>
  <Hero
    title="Împreună pentru cei aflați în nevoie"
    subtitle="Masa Rotundă Timișoara este o organizație non-profit dedicată acțiunilor de caritate și sprijin comunitar. Credem că fiecare gest de bunătate contează."
  />

  <!-- Misiune scurtă -->
  <section class="section">
    <div class="container text-center">
      <SectionHeading title="Misiunea noastră" />
      <p style="max-width: 700px; margin: 0 auto; font-size: 1.1rem; line-height: 1.8;">
        Ne dedicăm sprijinirii persoanelor vulnerabile din Timișoara și județul Timiș prin programe de asistență socială, educație și sănătate. Credem în puterea comunității de a transforma vieți.
      </p>
    </div>
  </section>

  <!-- Cifre de impact -->
  <ImpactNumbers />

  <!-- Proiecte recente -->
  <section class="section">
    <div class="container">
      <SectionHeading title="Proiectele noastre" subtitle="Descoperă programele prin care facem diferența în comunitate" />
      <div class="grid-3">
        {proiecte.map(proiect => (
          <ProjectCard
            titlu={proiect.data.titlu}
            descriere={proiect.data.descriere}
            imagine={proiect.data.imagine}
            categorie={proiect.data.categorie}
            status={proiect.data.status}
            slug={proiect.id}
          />
        ))}
      </div>
      <div class="text-center" style="margin-top: var(--space-xl);">
        <a href={getRelativePath('/proiecte/')} class="btn btn-secondary">Vezi toate proiectele</a>
      </div>
    </div>
  </section>

  <!-- CTA Voluntariat -->
  <section class="section cta-section">
    <div class="container text-center">
      <h2>Vrei să faci diferența?</h2>
      <p style="max-width: 600px; margin: var(--space-md) auto;">Alătură-te echipei noastre de voluntari și contribuie la schimbarea pe care vrei să o vezi în comunitate.</p>
      <div style="display: flex; gap: var(--space-md); justify-content: center; flex-wrap: wrap;">
        <a href={getRelativePath('/voluntariat/')} class="btn btn-primary">Fii voluntar</a>
        <a href={getRelativePath('/donatii/')} class="btn btn-accent">Donează acum</a>
      </div>
    </div>
  </section>

  <!-- Parteneri -->
  <section class="section">
    <div class="container">
      <SectionHeading title="Partenerii noștri" subtitle="Mulțumim organizațiilor care ne susțin misiunea" />
      <PartnerGrid parteneri={parteneri.map(p => p.data)} />
    </div>
  </section>
</BaseLayout>

<style>
  .cta-section {
    background: var(--color-bg-alt);
    padding: clamp(4.5rem, 6vw, 6rem) 0;
  }
  .cta-section h2 {
    color: var(--color-primary);
    font-size: clamp(1.8rem, 2.5vw + 0.5rem, 2.5rem);
    margin-bottom: var(--space-xs);
  }
  .cta-section p {
    color: var(--color-text-light);
    font-size: var(--font-size-md);
    line-height: var(--line-height-base);
  }
  .cta-section .btn-accent {
    background-color: var(--color-accent);
    color: var(--color-primary-dark);
    border-color: var(--color-accent);
    font-weight: 700;
    box-shadow: 0 4px 14px rgba(212, 168, 67, 0.35);
  }
  .cta-section .btn-accent:hover {
    background-color: var(--color-accent-light);
    border-color: var(--color-accent-light);
    color: var(--color-primary-dark);
    box-shadow: 0 6px 18px rgba(212, 168, 67, 0.45);
    transform: translateY(-2px) scale(1.02);
  }
</style>
