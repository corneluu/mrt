---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { getRelativePath } from '@/utils/paths';
import Hero from '@/components/Hero.astro';
import SectionHeading from '@/components/SectionHeading.astro';

const distributieFonduri = [
  { domeniu: 'Programe sociale și hrană caldă', procent: 60, culoare: '#2E7D32', descriere: 'Mese calde săptămânale și pachete cu alimente de bază.' },
  { domeniu: 'Educație și rechizite școlare', procent: 20, culoare: '#1976D2', descriere: 'Meditații, ghiozdane echipate și tabere pentru copii.' },
  { domeniu: 'Sănătate și caravane medicale', procent: 15, culoare: '#D97706', descriere: 'Consultații medicale gratuite în zonele rurale defavorizate.' },
  { domeniu: 'Logistică și administrare', procent: 5, culoare: '#64748B', descriere: 'Costuri minime de transport, depozitare și organizare.' },
];
---

<BaseLayout title="Donații" description="Susține asociația Masa Rotundă Timișoara prin donație bancară directă, redirecționarea a 3,5% din impozit sau sponsorizare corporate.">
  <Hero
    title="Susține cauza noastră"
    subtitle="Fiecare contribuție se transformă direct în hrană, educație și sprijin pentru cei aflați în nevoie din comunitatea Timișoarei."
    showCTA={false}
  />

  <!-- Quick Navigation Pill Bar (Perfect on Mobile & Desktop) -->
  <section class="quick-nav-section" aria-label="Navigare rapidă opțiuni de donație">
    <div class="container">
      <div class="quick-nav-pills">
        <a href="#transfer-bancar" class="pill-btn">
          <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect width="20" height="14" x="2" y="5" rx="2"></rect><line x1="2" x2="22" y1="10" y2="10"></line></svg>
          Transfer Bancar (IBAN)
        </a>
        <a href="#formular-230" class="pill-btn">
          <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M14.5 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7.5L14.5 2z"></path><polyline points="14 2 14 8 20 8"></polyline><line x1="16" x2="8" y1="13" y2="13"></line><line x1="16" x2="8" y1="17" y2="17"></line><line x1="10" x2="8" y1="9" y2="9"></line></svg>
          Redirecționează 3,5%
        </a>
        <a href="#plata-online" class="pill-btn">
          <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="10"></circle><line x1="2" x2="22" y1="12" y2="12"></line><path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"></path></svg>
          Plată Online
        </a>
        <a href="#transparenta" class="pill-btn">
          <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M22 12h-4l-3 9L9 3l-3 9H2"></path></svg>
          Unde merg banii
        </a>
      </div>
    </div>
  </section>

  <!-- 1. Transfer Bancar (Highlight Card Principal) -->
  <section class="section" id="transfer-bancar">
    <div class="container narrow-container">
      <SectionHeading
        title="Donație prin Transfer Bancar"
        subtitle="Cea mai directă și eficientă metodă – 100% din sumă ajunge la beneficiari, fără comisioane ale intermediarilor."
      />

      <div class="pro-bank-card">
        <div class="card-top-bar">
          <div class="bank-title-box">
            <span class="badge-official">Cont Oficial Organizație</span>
            <h3>Asociația Masa Rotundă Timișoara</h3>
          </div>
          <span class="currency-badge">MONEDĂ: LEI (RON)</span>
        </div>

        <div class="bank-info-table">
          <div class="bank-row">
            <span class="row-label">Beneficiar</span>
            <div class="row-content">
              <strong>Asociația Masa Rotundă Timișoara</strong>
              <button type="button" class="mini-copy-btn" data-copy="Asociația Masa Rotundă Timișoara" aria-label="Copiază numele beneficiarului">
                Copiază
              </button>
            </div>
          </div>

          <div class="bank-row">
            <span class="row-label">Cod Fiscal (CUI)</span>
            <div class="row-content">
              <code class="code-val" id="cuiValue">RO12345678</code>
              <button type="button" class="mini-copy-btn" data-copy="RO12345678" aria-label="Copiază Codul Fiscal">
                Copiază
              </button>
            </div>
          </div>

          <div class="bank-row">
            <span class="row-label">Banca</span>
            <div class="row-content">
              <span>Banca Transilvania – Sucursala Timișoara</span>
            </div>
          </div>

          <!-- Highlight IBAN box with primary 1-tap copy -->
          <div class="iban-major-box">
            <div class="iban-header">
              <span class="iban-title">CONT IBAN (RON)</span>
              <span class="copy-feedback" id="ibanStatusText">Apasă pentru copiere rapidă</span>
            </div>
            <div class="iban-action-row">
              <code class="iban-code" id="mainIbanCode">RO49 BTRL 0000 0000 0000 0000</code>
              <button type="button" class="btn btn-primary btn-copy-large" id="mainCopyIbanBtn">
                <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect width="14" height="14" x="8" y="8" rx="2" ry="2"></rect><path d="M4 16c-1.1 0-2-.9-2-2V4c0-1.1.9-2 2-2h10c1.1 0 2 .9 2 2"></path></svg>
                <span class="btn-text">Copiază IBAN</span>
              </button>
            </div>
          </div>

          <div class="bank-row note-row">
            <span class="row-label">Detalii plată</span>
            <div class="row-content">
              <em>„Donație susținere activități sociale Masa Rotundă”</em>
            </div>
          </div>
        </div>

        <div class="bank-card-footer">
          <div class="security-badge">
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path></svg>
            Cont bancar verificat și înregistrat la Registrul Asociațiilor
          </div>
          <p class="receipt-note">Pentru eliberarea unei chitanțe sau adeverințe de donație, scrie-ne la <a href="mailto:mrt@gmail.com">mrt@gmail.com</a>.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- 2. Formularul 230 - 3.5% (Card distinct și clar) -->
  <section class="section section-alt" id="formular-230">
    <div class="container narrow-container">
      <SectionHeading
        title="Redirecționează 3,5% din Impozit"
        subtitle="Un gest cu impact imens care nu te costă absolut nimic. Banii sunt redirecționați din impozitul deja reținut de stat."
      />

      <div class="card redirect-pro-card">
        <div class="redirect-header-grid">
          <div class="step-badge">100% GRATUIT</div>
          <h3>Cum funcționează Formularul 230?</h3>
          <p>Dacă ești angajat și ai obținut venituri din salarii în anul precedent, statul român îți permite să decizi unde ajung 3,5% din impozitul tău pe venit. Dacă nu completezi formularul, acești bani rămân la bugetul statului.</p>
        </div>

        <div class="redirect-steps-grid">
          <div class="step-card">
            <span class="step-num">1</span>
            <strong>Descarcă formularul</strong>
            <p>Formularul este deja completat cu datele fiscale ale Asociației Masa Rotundă Timișoara.</p>
          </div>
          <div class="step-card">
            <span class="step-num">2</span>
            <strong>Completează datele tale</strong>
            <p>Doar datele de identificare (Nume, CNP, semnătură) la Secțiunea I. Nu trebuie să calculezi suma!</p>
          </div>
          <div class="step-card">
            <span class="step-num">3</span>
            <strong>Trimite formularul</strong>
            <p>Online prin SPV (ANAF) sau ni-l poți trimite nouă pe email la <a href="mailto:mrt@gmail.com">mrt@gmail.com</a> și îl depunem noi.</p>
          </div>
        </div>

        <div class="redirect-info-box">
          <div class="info-title">Datele asociației pentru Formularul 230:</div>
          <div class="info-grid">
            <div><strong>Entitate:</strong> Asociația Masa Rotundă Timișoara</div>
            <div><strong>CUI:</strong> RO12345678</div>
            <div><strong>Cont IBAN:</strong> RO49 BTRL 0000 0000 0000 0000</div>
          </div>
        </div>

        <div class="redirect-cta-bar">
          <a
            href="#"
            class="btn btn-primary btn-lg btn-download"
            onclick="alert('Formularul 230 precompletat în format PDF va fi disponibil pentru descărcare directă.'); return false;"
          >
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path><polyline points="7 10 12 15 17 10"></polyline><line x1="12" x2="12" y1="15" y2="3"></line></svg>
            Descarcă Formularul 230 (PDF)
          </a>
          <span class="deadline-pill">
            <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="10"></circle><polyline points="12 6 12 12 16 14"></polyline></svg>
            Termen limită anual ANAF: 25 Mai
          </span>
        </div>
      </div>
    </div>
  </section>

  <!-- 3. Plată online cu cardul -->
  <section class="section" id="plata-online">
    <div class="container narrow-container">
      <SectionHeading
        title="Plată Online cu Cardul"
        subtitle="Soluție rapidă pentru donații punctuale sau recurente cu cardul bancar"
      />

      <div class="card online-card">
        <div class="online-status-icon">
          <svg xmlns="http://www.w3.org/2000/svg" width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="var(--color-primary)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect width="20" height="14" x="2" y="5" rx="2"></rect><line x1="2" x2="22" y1="10" y2="10"></line></svg>
        </div>
        <h3>Modul de plată online securizat</h3>
        <p class="online-text">
          Integrarea cu procesatorul de plăți securizat (Stripe / Netopia) este în curs de finalizare. Între timp, transferul bancar direct este 100% operațional și recomandat.
        </p>
        <div class="online-button-wrapper">
          <a href="#transfer-bancar" class="btn btn-secondary">
            Donează prin transfer bancar →
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- 4. Unde merg banii tăi (Transparență totală) -->
  <section class="section section-alt" id="transparenta">
    <div class="container narrow-container">
      <SectionHeading
        title="Unde Merg Banii Tăi?"
        subtitle="Fiecare leu este alocat cu maximă responsabilitate și transparență."
      />

      <div class="transparency-grid">
        {distributieFonduri.map(item => (
          <div class="transparency-card">
            <div class="t-top">
              <span class="t-title">{item.domeniu}</span>
              <span class="t-percent" style={`color: ${item.culoare};`}>{item.procent}%</span>
            </div>
            <div class="t-bar-bg">
              <div class="t-bar-fill" style={`width: ${item.procent}%; background-color: ${item.culoare};`}></div>
            </div>
            <p class="t-desc">{item.descriere}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Contact & Sponsorizări Corporate -->
  <section class="section">
    <div class="container narrow-container text-center">
      <div class="sponsor-box">
        <h3>Ești o companie și vrei să redirecționezi 20% din impozit?</h3>
        <p>Conform Codului Fiscal, firmele pot sponsoriza asociații fără niciun cost suplimentar, scăzând suma direct din impozitul pe profit/venit datorat.</p>
        <div class="sponsor-actions">
          <a href={getRelativePath('/contact/')} class="btn btn-primary">Solicită contract de sponsorizare</a>
          <a href="tel:0771569557" class="btn btn-secondary">Sună la 0771 569 557</a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<script>
  // Unified Copy to Clipboard with Accessible Feedback
  function setupCopy() {
    const mainBtn = document.getElementById('mainCopyIbanBtn');
    const mainIban = document.getElementById('mainIbanCode');
    const statusText = document.getElementById('ibanStatusText');

    if (mainBtn && mainIban) {
      mainBtn.addEventListener('click', () => {
        const rawText = mainIban.textContent?.trim() || '';
        navigator.clipboard.writeText(rawText).then(() => {
          const btnText = mainBtn.querySelector('.btn-text');
          if (btnText) btnText.textContent = 'IBAN Copiat!';
          if (statusText) {
            statusText.textContent = '✓ Copiat în clipboard!';
            statusText.style.color = 'var(--color-success, #2E7D32)';
          }
          mainBtn.classList.add('copied');
          setTimeout(() => {
            if (btnText) btnText.textContent = 'Copiază IBAN';
            if (statusText) {
              statusText.textContent = 'Apasă pentru copiere rapidă';
              statusText.style.color = '';
            }
            mainBtn.classList.remove('copied');
          }, 2500);
        });
      });
    }

    // Mini buttons
    const miniBtns = document.querySelectorAll<HTMLButtonElement>('.mini-copy-btn');
    miniBtns.forEach(btn => {
      btn.addEventListener('click', () => {
        const textToCopy = btn.dataset.copy || '';
        navigator.clipboard.writeText(textToCopy).then(() => {
          const original = btn.textContent;
          btn.textContent = 'Copiat!';
          btn.classList.add('copied');
          setTimeout(() => {
            btn.textContent = original;
            btn.classList.remove('copied');
          }, 2000);
        });
      });
    });
  }

  setupCopy();
</script>

<style>
  .narrow-container {
    max-width: 840px;
    margin-inline: auto;
  }

  /* Quick Navigation Pills */
  .quick-nav-section {
    background-color: var(--color-white);
    border-bottom: 1px solid var(--color-border);
    padding: var(--space-sm) 0;
    position: sticky;
    top: 65px;
    z-index: 40;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.04);
  }

  .quick-nav-pills {
    display: flex;
    gap: var(--space-xs);
    overflow-x: auto;
    padding-bottom: 2px;
    scrollbar-width: none;
    -webkit-overflow-scrolling: touch;
    justify-content: flex-start;
  }

  .quick-nav-pills::-webkit-scrollbar {
    display: none;
  }

  .pill-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.45rem 0.9rem;
    background-color: var(--color-bg-alt);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-full);
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--color-text);
    white-space: nowrap;
    text-decoration: none;
    transition: all var(--transition-fast);
    flex-shrink: 0;
  }

  .pill-btn:hover {
    background-color: var(--color-primary);
    color: var(--color-white);
    border-color: var(--color-primary);
  }

  @media (min-width: 768px) {
    .quick-nav-pills {
      justify-content: center;
      gap: var(--space-sm);
    }
    .pill-btn {
      font-size: 0.9rem;
      padding: 0.5rem 1.1rem;
    }
  }

  /* Professional Bank Card */
  .pro-bank-card {
    background: var(--color-white);
    border: 2px solid var(--color-primary);
    border-radius: var(--radius-md);
    box-shadow: 0 8px 30px rgba(27, 58, 92, 0.12);
    overflow: hidden;
  }

  .card-top-bar {
    background: linear-gradient(135deg, var(--color-primary-dark) 0%, var(--color-primary) 100%);
    color: var(--color-white);
    padding: var(--space-lg);
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: var(--space-sm);
  }

  .bank-title-box h3 {
    color: var(--color-white);
    margin: var(--space-xs) 0 0;
    font-size: clamp(1.2rem, 2.5vw, 1.5rem);
  }

  .badge-official {
    display: inline-block;
    background: rgba(212, 168, 67, 0.25);
    color: var(--color-accent-light);
    border: 1px solid var(--color-accent);
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.05em;
    padding: 0.2rem 0.6rem;
    border-radius: var(--radius-full);
    text-transform: uppercase;
  }

  .currency-badge {
    background: rgba(255, 255, 255, 0.15);
    color: var(--color-white);
    font-size: 0.8rem;
    font-weight: 700;
    letter-spacing: 0.05em;
    padding: 0.3rem 0.8rem;
    border-radius: var(--radius-sm);
  }

  .bank-info-table {
    padding: var(--space-lg);
    display: flex;
    flex-direction: column;
    gap: var(--space-md);
  }

  .bank-row {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    padding-bottom: var(--space-sm);
    border-bottom: 1px dashed var(--color-border);
  }

  @media (min-width: 640px) {
    .bank-row {
      flex-direction: row;
      justify-content: space-between;
      align-items: center;
    }
  }

  .row-label {
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--color-text-light);
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .row-content {
    display: flex;
    align-items: center;
    gap: var(--space-sm);
    flex-wrap: wrap;
  }

  .code-val {
    font-family: var(--font-family-mono, monospace);
    font-size: 1.05rem;
    font-weight: 700;
    color: var(--color-text);
  }

  .mini-copy-btn {
    background: var(--color-bg-alt);
    border: 1px solid var(--color-border);
    color: var(--color-primary);
    padding: 0.25rem 0.6rem;
    border-radius: var(--radius-xs);
    font-size: 0.75rem;
    font-weight: 600;
    cursor: pointer;
    transition: all var(--transition-fast);
  }

  .mini-copy-btn:hover {
    background: var(--color-primary);
    color: var(--color-white);
    border-color: var(--color-primary);
  }

  .mini-copy-btn.copied {
    background: var(--color-success, #2E7D32);
    color: #fff;
    border-color: var(--color-success, #2E7D32);
  }

  /* Major IBAN Box */
  .iban-major-box {
    background: #F8F9FA;
    border: 2px solid var(--color-accent);
    border-radius: var(--radius-md);
    padding: var(--space-md);
    margin-block: var(--space-sm);
  }

  .iban-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: var(--space-xs);
    flex-wrap: wrap;
    gap: var(--space-xs);
  }

  .iban-title {
    font-size: 0.8rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    color: var(--color-primary);
  }

  .copy-feedback {
    font-size: 0.75rem;
    font-weight: 600;
    color: var(--color-text-muted);
  }

  .iban-action-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-md);
    flex-wrap: wrap;
  }

  .iban-code {
    font-family: var(--font-family-mono, monospace);
    font-size: clamp(1rem, 2.5vw, 1.35rem);
    font-weight: 700;
    color: var(--color-primary-dark);
    letter-spacing: 0.05em;
    word-break: break-all;
  }

  .btn-copy-large {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.65rem 1.25rem;
    font-size: 0.95rem;
    font-weight: 600;
    cursor: pointer;
    flex-shrink: 0;
  }

  .btn-copy-large.copied {
    background: var(--color-success, #2E7D32);
    border-color: var(--color-success, #2E7D32);
  }

  .bank-card-footer {
    background: var(--color-bg);
    padding: var(--space-md) var(--space-lg);
    border-top: 1px solid var(--color-border);
    display: flex;
    flex-direction: column;
    gap: var(--space-xs);
  }

  .security-badge {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--color-primary);
  }

  .receipt-note {
    font-size: 0.85rem;
    color: var(--color-text-light);
    margin: 0;
  }

  .receipt-note a {
    color: var(--color-secondary);
    font-weight: 600;
  }

  /* Redirect 3.5% Card */
  .redirect-pro-card {
    padding: var(--space-xl);
  }

  .redirect-header-grid {
    margin-bottom: var(--space-lg);
  }

  .step-badge {
    display: inline-block;
    background: rgba(72, 187, 120, 0.2);
    color: #22543D;
    font-weight: 700;
    font-size: 0.8rem;
    padding: 0.25rem 0.75rem;
    border-radius: var(--radius-full);
    margin-bottom: var(--space-xs);
  }

  .redirect-steps-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-md);
    margin-bottom: var(--space-xl);
  }

  @media (min-width: 640px) {
    .redirect-steps-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .step-card {
    background: var(--color-bg-alt);
    border: 1px solid var(--color-border);
